# Dependencies and generated Next.js output
node_modules/
.next/

# Prisma Client packed for hosts that cannot reach binaries.prisma.sh
# (npm run prisma:offline-bundle — see DEPLOYMENT.md, Appendix D)
prisma-offline-client.tgz

# Deployment archive produced by `npm run deploy:zip`
/deploy.zip

# Local configuration and credentials
.env
.env.local

# Logs
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Passenger restart file and runtime logs on cPanel (keep the folder itself)
/tmp/*
!/tmp/.gitkeep
