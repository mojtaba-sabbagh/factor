# Copy to .env.local for development, or to .env on the cPanel host.
# Never commit either file.

# PostgreSQL connection string. On cPanel the database lives on the same server,
# so the host is localhost. The names come from cPanel's "PostgreSQL Databases"
# page (the database and user are prefixed with your cPanel account name).
# connection_limit keeps Prisma from opening more connections than shared
# hosting allows.
DATABASE_URL="postgresql://cpaneluser_dbuser:password@localhost:5432/cpaneluser_factordb?schema=public&connection_limit=5&pool_timeout=20"

# Long random string used to sign session cookies and password-recovery links.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the app, without a trailing slash. Only used to build the
# password-recovery link that is written to the server log.
APP_URL="https://example.com"

# Optional. Session cookies are Secure by default in production. Only set this
# to "false" if the site is reachable over plain HTTP with no SSL certificate
# yet, otherwise the browser drops the cookie and logins loop back to /login.
# SESSION_COOKIE_SECURE="false"

