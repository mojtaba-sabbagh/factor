{
  "name": "factor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run copy-static",
    "copy-static": "node src/scripts/copy-static.js",
    "deploy": "npm run build && npm run deploy:zip",
    "deploy:zip": "node src/scripts/create-deploy-zip.js",
    "start": "node server.js",
    "serve": "node server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:offline-bundle": "node src/scripts/prisma-offline-bundle.js",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "doctor": "node src/scripts/doctor.js",
    "create:superadmin": "node src/scripts/create-superadmin.js",
    "reset:password": "node src/scripts/reset-password.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.3",
    "next": "^14.2.5",
    "pdfjs-dist": "^4.6.82",
    "prisma": "^5.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "typescript": "5.9.3"
  }
}
